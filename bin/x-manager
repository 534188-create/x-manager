#!/usr/bin/env bash
# ==============================================================================
# x-manager: Единый центр управления всеми прокси и VPN службами
# Сервер: Gateway (89.19.223.185)
# Поддерживаемые сервисы:
#   1. Mieru (mita v3.37.0)
#   2. Snell (v5.0.1)
#   3. WDTT / qwdtt (VPN Server)
# ==============================================================================

set -e
clear() { command clear 2>/dev/null || true; }

# Цвета терминала
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

# Пути к файлам конфигурации
MIERU_CONFIG_DIR="/etc/mita"
MIERU_CONFIG_FILE="/etc/mita/config.json"
MIERU_USER_STORE="/etc/mita/users_db.json"

SNELL_CONFIG_DIR="/etc/snell"
SNELL_CONFIG_FILE="/etc/snell/snell-server.conf"
SNELL_ROUTING_FILE="/etc/snell/routing.mode"

WDTT_DIR="/etc/wdtt"
WDTT_PASSWORD_FILE="/etc/wdtt/main.password"
WDTT_DB_FILE="/etc/wdtt/passwords.json"
WDTT_PROFILE_FILE="/etc/wdtt/profile_name.txt"
WDTT_SERVICE_FILE="/etc/systemd/system/wdtt.service"

CSQTT_DIR="/etc/csqtt"
CSQTT_ENV_FILE="/etc/csqtt/csqtt.env"
CSQTT_LOCK_FILE="/etc/csqtt/ssh_only.lock"
CSQTT_NET_UP="/usr/local/lib/csqtt/network-up.sh"
CSQTT_SERVICE_FILE="/etc/systemd/system/csqtt.service"
# Пути к файлам DNS-туннелей (CottenDNS / MasterDnsVPN)
COTTEN_DIR="/etc/cottendns"
COTTEN_BIN="/usr/local/bin/cottendns-server"
COTTEN_CONFIG_FILE="/etc/cottendns/server_config.toml"
COTTEN_KEY_FILE="/etc/cottendns/encrypt_key.txt"
COTTEN_SERVICE="cottendns"

MASTERDNS_DIR="/etc/masterdns"
MASTERDNS_BIN="/usr/local/bin/masterdns-server"
MASTERDNS_CONFIG_FILE="/etc/masterdns/server_config.toml"
MASTERDNS_KEY_FILE="/etc/masterdns/encrypt_key.txt"
MASTERDNS_SERVICE="masterdns"

DNS_WAN_LOCK="/etc/x-manager/dns_wan_blocked.lock"


WAN_IF=$(ip route show default 2>/dev/null | awk '{print $5}' | head -n 1)
[ -z "$WAN_IF" ] && WAN_IF="ens3"

IP_FILE="/etc/mita/server_ip.txt"


# ------------------------------------------------------------------------------
# Проверка наличия установленных сервисов (Dynamic Detection)
# ------------------------------------------------------------------------------
is_mieru_installed() {
    command -v mita >/dev/null 2>&1 || [ -f "$MIERU_CONFIG_FILE" ] || [ -f "/etc/systemd/system/mita.service" ]
}

is_snell_installed() {
    command -v snell-server >/dev/null 2>&1 || [ -f "$SNELL_CONFIG_FILE" ] || [ -f "/etc/systemd/system/snell.service" ]
}

is_wdtt_installed() {
    command -v wdtt >/dev/null 2>&1 || [ -f "/etc/systemd/system/wdtt.service" ] || [ -d "$WDTT_DIR" ]
}

is_cottendns_installed() {
    [ -f "$COTTEN_BIN" ] || [ -f "/etc/systemd/system/${COTTEN_SERVICE}.service" ] || [ -d "$COTTEN_DIR" ]
}

is_masterdns_installed() {
    [ -f "$MASTERDNS_BIN" ] || [ -f "/etc/systemd/system/${MASTERDNS_SERVICE}.service" ] || [ -d "$MASTERDNS_DIR" ]
}

is_dns_installed() {
    is_cottendns_installed || is_masterdns_installed
}

get_server_ip() {
    if [ -f "$IP_FILE" ]; then
        cat "$IP_FILE"
    else
        local ip=$(curl -4 -s -m 3 https://api.ipify.org || curl -4 -s -m 3 https://ifconfig.me || ip route get 1.1.1.1 2>/dev/null | awk '{print $7}')
        [ -n "$ip" ] && echo "$ip" > "$IP_FILE"
        echo "$ip"
    fi
}

SERVER_IP=$(get_server_ip)

# ------------------------------------------------------------------------------
# Вспомогательные функции: MIERU
# ------------------------------------------------------------------------------
get_mieru_status() {
    if ! is_mieru_installed; then
        echo -e "${RED}НЕ УСТАНОВЛЕН${NC}"
        return
    fi
    if systemctl is-active --quiet mita; then
        local m_stat=$(mita status 2>/dev/null)
        if [[ "$m_stat" =~ "RUNNING" ]]; then
            echo -e "${GREEN}АКТИВЕН (В РАБОТЕ)${NC}"
        elif [[ "$m_stat" =~ "IDLE" ]]; then
            echo -e "${GREEN}АКТИВЕН (ОЖИДАНИЕ)${NC}"
        else
            echo -e "${GREEN}АКТИВЕН (ОНЛАЙН)${NC}"
        fi
    else
        echo -e "${RED}ОСТАНОВЛЕН${NC}"
    fi
}

get_mieru_ports() {
    if [ -f "$MIERU_CONFIG_FILE" ]; then
        local p=$(jq -r '.portBindings[0].portRange // .portBindings[0].port // "Не заданы"' "$MIERU_CONFIG_FILE" 2>/dev/null)
        local proto=$(jq -r '.portBindings[0].protocol // "TCP"' "$MIERU_CONFIG_FILE" 2>/dev/null)
        echo "${p}/${proto}"
    else
        echo "446-447/UDP"
    fi
}

get_mieru_preset() {
    if [ -f "$MIERU_CONFIG_FILE" ]; then
        local has_low=$(jq -r '.trafficPattern.lowEntropy.mode // empty' "$MIERU_CONFIG_FILE" 2>/dev/null)
        local has_rot=$(jq -r '.trafficPattern.lowEntropy.maskRotation // empty' "$MIERU_CONFIG_FILE" 2>/dev/null)
        local has_frag=$(jq -r '.trafficPattern.tcpFragment.enable // false' "$MIERU_CONFIG_FILE" 2>/dev/null)
        local has_nonce=$(jq -r '.trafficPattern.nonce.type // empty' "$MIERU_CONFIG_FILE" 2>/dev/null)
        
        if [ -n "$has_low" ] && [ "$has_low" != "LOW_ENTROPY_MODE_OFF" ]; then
            local short_mode=$(echo "$has_low" | sed 's/LOW_ENTROPY_MODE_//')
            local short_rot=$(echo "$has_rot" | sed 's/LOW_ENTROPY_MASK_//' | sed 's/ROTATE_RIGHT_/R-/' | sed 's/ROTATE_LEFT_/L-/')
            echo -e "${PURPLE}Low-Entropy ${short_mode} (${short_rot})${NC}"
        elif [ "$has_nonce" = "NONCE_TYPE_PRINTABLE" ]; then
            echo -e "${CYAN}Medium (Printable Nonce)${NC}"
        elif [ "$has_frag" = "true" ]; then
            echo -e "${BLUE}Basic (Фрагментация)${NC}"
        else
            echo -e "${YELLOW}Disabled (Без обфускации)${NC}"
        fi
    else
        echo "Не определен"
    fi
}

get_mieru_routing() {
    if [ -f "$MIERU_CONFIG_FILE" ]; then
        local p_name=$(jq -r '.egress.proxies[0].name // empty' "$MIERU_CONFIG_FILE" 2>/dev/null)
        local p_port=$(jq -r '.egress.proxies[0].port // empty' "$MIERU_CONFIG_FILE" 2>/dev/null)
        if [ "$p_name" = "xray_socks" ] && [ -n "$p_port" ]; then
            echo -e "${GREEN}Маршрутизация Xray${NC}"
        else
            echo -e "${YELLOW}Прямой выход${NC}"
        fi
    else
        echo "Прямой выход"
    fi
}

restart_mieru_and_verify() {
    mkdir -p "$MIERU_CONFIG_DIR"
    chown -R mita:mita "$MIERU_CONFIG_DIR"
    [ -f "$MIERU_CONFIG_FILE" ] && chmod 664 "$MIERU_CONFIG_FILE"
    systemctl daemon-reload
    systemctl restart mita
    sleep 2
    local m_stat=$(mita status 2>/dev/null)
    if [[ "$m_stat" =~ "RUNNING" ]] || [[ "$m_stat" =~ "IDLE" ]] || systemctl is-active --quiet mita; then
        echo -e "${GREEN}✓ Mieru успешно запущен и готов к работе (ONLINE)!${NC}"
    else
        echo -e "${RED}✗ Внимание: Mieru не смог запуститься!${NC}"
        journalctl -u mita -n 8 --no-pager
    fi
}

# ------------------------------------------------------------------------------
# Вспомогательные функции: SNELL (v5.0.1)
# ------------------------------------------------------------------------------
get_snell_status() {
    if ! is_snell_installed; then
        echo -e "${RED}НЕ УСТАНОВЛЕН${NC}"
        return
    fi
    if systemctl is-active --quiet snell; then
        echo -e "${GREEN}АКТИВЕН (RUNNING)${NC}"
    else
        echo -e "${RED}ОСТАНОВЛЕН${NC}"
    fi
}

get_snell_port() {
    if [ -f "$SNELL_CONFIG_FILE" ]; then
        grep -E "^listen" "$SNELL_CONFIG_FILE" | awk -F':' '{print $NF}' | tr -d ' '
    else
        echo "14880"
    fi
}

get_snell_psk() {
    if [ -f "$SNELL_CONFIG_FILE" ]; then
        grep -E "^psk" "$SNELL_CONFIG_FILE" | awk -F'=' '{print $2}' | tr -d ' '
    else
        echo "Не задан"
    fi
}

get_snell_obfs() {
    if [ -f "$SNELL_CONFIG_FILE" ]; then
        local obfs=$(grep -a -E "^obfs[[:space:]]*=" "$SNELL_CONFIG_FILE" | awk -F'=' '{print $2}' | tr -d ' ')
        local host=$(grep -a -E "^obfs-host[[:space:]]*=" "$SNELL_CONFIG_FILE" | awk -F'=' '{print $2}' | tr -d ' ')
        if [ -n "$obfs" ] && [ "$obfs" != "off" ]; then
            echo "${obfs} (${host})"
        else
            echo "Отключена (Чистый Snell v5)"
        fi
    else
        echo "Не настроен"
    fi
}

get_snell_tag() {
    if [ -f "/etc/snell/tag.txt" ]; then
        local t=$(cat "/etc/snell/tag.txt" | tr -d '[:space:]')
        [ -n "$t" ] && echo "$t" || echo "Snell-v5"
    else
        echo "Snell-v5"
    fi
}

snell_change_tag() {
    show_snell_header
    local cur_tag=$(get_snell_tag)
    echo -e "${BOLD}--- Настройка имени подключения Snell ---${NC}"
    echo -e "Текущее имя подключения: ${CYAN}${cur_tag}${NC}"
    echo ""
    read -p "Введите новое имя подключения (например, Snell-Home, Proxy-1): " new_tag
    if [ -n "$new_tag" ]; then
        new_tag=$(echo "$new_tag" | tr -d '#&/?')
        mkdir -p /etc/snell
        echo "$new_tag" > /etc/snell/tag.txt
        echo -e "${GREEN}✓ Имя подключения сохранено: ${new_tag}${NC}"
        sleep 2
    fi
}

get_mieru_tag() {
    if [ -f "/etc/mieru/tag.txt" ]; then
        local t=$(cat "/etc/mieru/tag.txt" | tr -d '[:space:]')
        [ -n "$t" ] && echo "$t" || echo "Mieru"
    else
        echo "Mieru"
    fi
}

mieru_change_tag() {
    show_mieru_header
    local cur_tag=$(get_mieru_tag)
    echo -e "${BOLD}--- Настройка имени подключения Mieru ---${NC}"
    echo -e "Текущее имя подключения: ${CYAN}${cur_tag}${NC}"
    echo ""
    read -p "Введите новое имя подключения (например, Mieru-Home): " new_tag
    if [ -n "$new_tag" ]; then
        new_tag=$(echo "$new_tag" | tr -d '#&/?')
        mkdir -p /etc/mieru
        echo "$new_tag" > /etc/mieru/tag.txt
        echo -e "${GREEN}✓ Имя подключения сохранено: ${new_tag}${NC}"
        sleep 2
    fi
}


get_snell_routing() {
    local mode="xray"
    [ -f "$SNELL_ROUTING_FILE" ] && mode=$(cat "$SNELL_ROUTING_FILE" | tr -d ' ')
    if [ "$mode" = "xray" ]; then
        echo -e "${GREEN}Маршрутизация Xray${NC}"
    else
        echo -e "${YELLOW}Прямой выход${NC}"
    fi
}

restart_snell_and_verify() {
    chown -R snell:snell "$SNELL_CONFIG_DIR"
    chmod 644 "$SNELL_CONFIG_FILE"
    systemctl daemon-reload
    systemctl restart snell
    sleep 2
    if systemctl is-active --quiet snell; then
        echo -e "${GREEN}✓ Snell v5 успешно перезапущен и работает (RUNNING)!${NC}"
    else
        echo -e "${RED}✗ Внимание: Snell не смог запуститься!${NC}"
        journalctl -u snell -n 8 --no-pager
    fi
}

# ------------------------------------------------------------------------------
# Вспомогательные функции: WDTT
# ------------------------------------------------------------------------------
get_wdtt_status() {
    if ! is_wdtt_installed; then
        echo -e "${RED}НЕ УСТАНОВЛЕН${NC}"
        return
    fi
    if systemctl is-active --quiet wdtt; then
        echo -e "${GREEN}АКТИВЕН (RUNNING)${NC}"
    else
        echo -e "${RED}ОСТАНОВЛЕН${NC}"
    fi
}

get_wdtt_password() {
    if [ -f "$WDTT_PASSWORD_FILE" ]; then
        cat "$WDTT_PASSWORD_FILE" | tr -d '\r\n'
    else
        echo "sad_534188_sad"
    fi
}

get_wdtt_peer_port() {
    local port=""
    if [ -f "$WDTT_SERVICE_FILE" ]; then
        port=$(grep -oP -- '-listen\s+[0-9.]+:\K[0-9]+' "$WDTT_SERVICE_FILE" 2>/dev/null || true)
    fi
    if [ -z "$port" ]; then
        port=$(ss -ulpn 2>/dev/null | grep wdtt-server | awk '{print $4}' | awk -F: '{print $NF}' | grep -v '56001\|37001' | head -n 1 || true)
    fi
    if [ -z "$port" ]; then
        port="56000"
    fi
    echo "$port"
}

get_wdtt_profile_name() {
    if [ -f "$WDTT_PROFILE_FILE" ]; then
        cat "$WDTT_PROFILE_FILE" | tr -d '\r\n'
    else
        echo "WDTT-${SERVER_IP}"
    fi
}

wdtt_change_profile_name() {
    show_wdtt_header
    local cur_name=$(get_wdtt_profile_name)
    echo -e "${BOLD}--- Смена названия подключения WDTT (qwdtt) ---${NC}"
    echo -e "Текущее название: ${CYAN}${cur_name}${NC}"
    echo ""
    read -p "Введите новое название подключения (например: СПб обход бс): " new_name
    if [ -n "$new_name" ]; then
        mkdir -p "$WDTT_DIR"
        echo -n "$new_name" > "$WDTT_PROFILE_FILE"
        echo -e "${GREEN}✓ Название подключения обновлено: ${new_name}${NC}"
    else
        echo -e "${YELLOW}Изменения отменены (пустое значение).${NC}"
    fi
    sleep 1.5
}

get_wdtt_routing() {
    if iptables -t mangle -C PREROUTING -i wdtt0 -j WDTT_TPROXY 2>/dev/null; then
        echo -e "${GREEN}Маршрутизация Xray${NC}"
    else
        echo -e "${YELLOW}Прямой выход${NC}"
    fi
}

restart_wdtt_and_verify() {
    systemctl daemon-reload
    systemctl restart wdtt
    sleep 2
    if systemctl is-active --quiet wdtt; then
        echo -e "${GREEN}✓ WDTT успешно перезапущен и работает (RUNNING)!${NC}"
    else
        echo -e "${RED}✗ Внимание: WDTT не смог запуститься!${NC}"
        journalctl -u wdtt -n 8 --no-pager
    fi
}

# ==============================================================================
# РАЗДЕЛ 1: УПРАВЛЕНИЕ MIERU
# ==============================================================================
show_mieru_header() {
    clear
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}               РАЗДЕЛ: УПРАВЛЕНИЕ MIERU (mita v3.37.0)                 ${CYAN}║${NC}"
    echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
    echo -e "${CYAN}║${NC}  Сервер:     ${BOLD}${SERVER_IP}${NC}  |  Служба: $(get_mieru_status)"
    echo -e "${CYAN}║${NC}  Имя:        ${BOLD}$(get_mieru_tag)${NC}  |  Обфускация: $(get_mieru_preset)"
    echo -e "${CYAN}║${NC}  Порты:      ${BOLD}$(get_mieru_ports)${NC}"
    echo -e "${CYAN}║${NC}  Маршрут:    $(get_mieru_routing)"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
}

mieru_manage_users() {
    while true; do
        show_mieru_header
        echo -e "${BOLD}--- Список зарегистрированных пользователей Mieru ---${NC}"
        jq -r '.users[] | "  Логин: \(.name)"' "$MIERU_CONFIG_FILE" 2>/dev/null || echo "  Нет пользователей"
        echo ""
        echo -e "${YELLOW}[1]${NC} Добавить пользователя"
        echo -e "${YELLOW}[2]${NC} Удалить пользователя"
        echo -e "${YELLOW}[3]${NC} Показать пароли пользователей"
        echo -e "${YELLOW}[0]${NC} Назад в меню Mieru"
        echo ""
        read -p "Выберите действие [0-3]: " u_act
        case "$u_act" in
            1)
                read -p "Введите логин пользователя: " u_name
                [ -z "$u_name" ] && continue
                read -p "Введите пароль (или Enter для автогенерации): " u_pass
                if [ -z "$u_pass" ]; then
                    u_pass=$(openssl rand -base64 12 | tr -dc 'a-zA-Z0-9' | head -c 16)
                    echo -e "Сгенерирован пароль: ${GREEN}${u_pass}${NC}"
                fi
                local tmp_cfg="/tmp/mita_usr_cfg.json"
                jq --arg n "$u_name" --arg p "$u_pass" \
                   '.users = ([.users[] | select(.name != $n)] + [{"name": $n, "password": $p, "allowPrivateIP": true, "allowLoopbackIP": true}])' \
                   "$MIERU_CONFIG_FILE" > "$tmp_cfg" && mv "$tmp_cfg" "$MIERU_CONFIG_FILE"
                local tmp_store="/tmp/users_db_tmp.json"
                cat "$MIERU_USER_STORE" | jq --arg u "$u_name" --arg p "$u_pass" '.[$u] = $p' > "$tmp_store" && mv "$tmp_store" "$MIERU_USER_STORE"
                restart_mieru_and_verify
                sleep 2
                ;;
            2)
                read -p "Введите имя пользователя для удаления: " del_name
                [ -z "$del_name" ] && continue
                local count_users=$(jq '.users | length' "$MIERU_CONFIG_FILE" 2>/dev/null || echo 0)
                if [ "$count_users" -le 1 ]; then
                    echo -e "${RED}Нельзя удалить единственного пользователя!${NC}"
                    sleep 2
                    continue
                fi
                local tmp_cfg="/tmp/mita_usr_cfg.json"
                jq --arg n "$del_name" '.users = [.users[] | select(.name != $n)]' "$MIERU_CONFIG_FILE" > "$tmp_cfg" && mv "$tmp_cfg" "$MIERU_CONFIG_FILE"
                local tmp_store="/tmp/users_db_tmp.json"
                cat "$MIERU_USER_STORE" | jq --arg u "$del_name" 'del(.[$u])' > "$tmp_store" && mv "$tmp_store" "$MIERU_USER_STORE"
                restart_mieru_and_verify
                sleep 2
                ;;
            3)
                show_mieru_header
                echo -e "${BOLD}--- Сохраненные пароли пользователей Mieru ---${NC}"
                cat "$MIERU_USER_STORE" | jq -r 'to_entries[] | "  Логин: \(.key) | Пароль: \(.value)"'
                echo ""
                read -p "Нажмите Enter для возврата..."
                ;;
            0) return ;;
        esac
    done
}

mieru_change_ports() { mieru_manage_ports "$@"; }

mieru_manage_ports() {
    show_mieru_header
    local cur_ports_str=$(get_mieru_ports)
    local old_ports=$(echo "$cur_ports_str" | cut -d'/' -f1)
    local old_proto=$(echo "$cur_ports_str" | cut -d'/' -f2 | tr '[:upper:]' '[:lower:]')

    echo -e "${BOLD}--- Настройка портов сервера Mieru ---${NC}"
    echo "Текущие порты: ${cur_ports_str}"
    echo ""
    echo "Примеры: диапазон 446-447, 2012-2022 или одиночный порт 2012 / 8443."
    echo ""
    read -p "Введите новый диапазон или порт: " new_ports
    new_ports=$(echo "$new_ports" | tr -d ' ')
    [ -z "$new_ports" ] && return

    echo "Выберите транспортный протокол:"
    echo -e "${YELLOW}[1]${NC} TCP (Рекомендуется)"
    echo -e "${YELLOW}[2]${NC} UDP"
    read -p "Выбор [1-2, по умолчанию 1]: " proto_choice
    local proto="TCP"
    [ "$proto_choice" = "2" ] && proto="UDP"

    local tmp_cfg="/tmp/mita_port_cfg.json"
    case "$new_ports" in
        *-*)
            local p_start=$(echo "$new_ports" | cut -d'-' -f1)
            local p_end=$(echo "$new_ports" | cut -d'-' -f2)
            if ! [[ "$p_start" =~ ^[0-9]+$ ]] || ! [[ "$p_end" =~ ^[0-9]+$ ]] || [ "$p_start" -lt 1 ] || [ "$p_end" -gt 65535 ] || [ "$p_start" -gt "$p_end" ]; then
                echo -e "${RED}Ошибка: некорректный диапазон '$new_ports'! Числа должны быть от 1 до 65535.${NC}"
                sleep 2
                return
            fi
            jq --arg r "$new_ports" --arg pr "$proto" \
               '.portBindings = [{"portRange": $r, "protocol": $pr}]' \
               "$MIERU_CONFIG_FILE" > "$tmp_cfg" && mv "$tmp_cfg" "$MIERU_CONFIG_FILE"
            local ipt_proto=$(echo "$proto" | tr '[:upper:]' '[:lower:]')
            iptables -I INPUT 1 -p "$ipt_proto" --dport ${p_start}:${p_end} -j ACCEPT 2>/dev/null || true
            ;;
        *)
            if ! [[ "$new_ports" =~ ^[0-9]+$ ]] || [ "$new_ports" -lt 1 ] || [ "$new_ports" -gt 65535 ]; then
                echo -e "${RED}Ошибка: некорректный порт '$new_ports'! Число должно быть от 1 до 65535.${NC}"
                sleep 2
                return
            fi
            jq --argjson p "$new_ports" --arg pr "$proto" \
               '.portBindings = [{"port": $p, "protocol": $pr}]' \
               "$MIERU_CONFIG_FILE" > "$tmp_cfg" && mv "$tmp_cfg" "$MIERU_CONFIG_FILE"
            local ipt_proto=$(echo "$proto" | tr '[:upper:]' '[:lower:]')
            iptables -I INPUT 1 -p "$ipt_proto" --dport "$new_ports" -j ACCEPT 2>/dev/null || true
            ;;
    esac

    # Удаляем старое правило из iptables (закрываем старый порт/диапазон)
    if [ -n "$old_ports" ] && [ "$old_ports" != "$new_ports" ]; then
        if [[ "$old_ports" =~ - ]]; then
            local o_s=$(echo "$old_ports" | cut -d'-' -f1)
            local o_e=$(echo "$old_ports" | cut -d'-' -f2)
            iptables -D INPUT -p "$old_proto" --dport ${o_s}:${o_e} -j ACCEPT 2>/dev/null || true
        else
            iptables -D INPUT -p "$old_proto" --dport "$old_ports" -j ACCEPT 2>/dev/null || true
        fi
    fi

    restart_mieru_and_verify
    echo -e "${GREEN}✓ Порты Mieru изменены на: ${new_ports} ($proto). Старый порт закрыт!${NC}"
    sleep 2
}

mieru_custom_entropy_builder() {
    show_mieru_header
    echo -e "${BOLD}--- Конструктор низкой энтропии и вращения маски Mieru ---${NC}"
    echo ""
    echo -e "${BOLD}Шаг 1: Выберите режим низкой энтропии (Low Entropy Mode):${NC}"
    echo -e "  ${YELLOW}[1]${NC} LOW_ENTROPY_MODE_32 (32 бит данных, оверхед 2.0x, макс. скрытность для РФ)"
    echo -e "  ${YELLOW}[2]${NC} LOW_ENTROPY_MODE_40 (40 бит данных, оверхед 1.6x)"
    echo -e "  ${YELLOW}[3]${NC} LOW_ENTROPY_MODE_48 (48 бит данных, оверхед 1.34x, сбалансированный)"
    echo -e "  ${YELLOW}[4]${NC} LOW_ENTROPY_MODE_56 (56 бит данных, оверхед 1.15x, легкий)"
    echo -e "  ${YELLOW}[5]${NC} LOW_ENTROPY_MODE_OFF (Отключить низкую энтропию)"
    echo -e "  ${YELLOW}[0]${NC} Отмена"
    echo ""
    read -p "Выберите режим [0-5]: " m_mode_choice

    local sel_mode=""
    case "$m_mode_choice" in
        1) sel_mode="LOW_ENTROPY_MODE_32" ;;
        2) sel_mode="LOW_ENTROPY_MODE_40" ;;
        3) sel_mode="LOW_ENTROPY_MODE_48" ;;
        4) sel_mode="LOW_ENTROPY_MODE_56" ;;
        5) sel_mode="LOW_ENTROPY_MODE_OFF" ;;
        0) return ;;
        *) echo "Неверный выбор"; sleep 1; return ;;
    esac

    local sel_rot="LOW_ENTROPY_MASK_NO_ROTATION"
    if [ "$sel_mode" != "LOW_ENTROPY_MODE_OFF" ]; then
        echo ""
        echo -e "${BOLD}Шаг 2: Выберите вращение маски (Low Entropy Mask Rotation):${NC}"
        echo -e "  ${YELLOW}[1]${NC} LOW_ENTROPY_MASK_ROTATE_RIGHT_7 ${GREEN}[Рекомендуемый для 64-бит]${NC}"
        echo -e "  ${YELLOW}[2]${NC} LOW_ENTROPY_MASK_ROTATE_RIGHT_3"
        echo -e "  ${YELLOW}[3]${NC} LOW_ENTROPY_MASK_ROTATE_RIGHT_1"
        echo -e "  ${YELLOW}[4]${NC} LOW_ENTROPY_MASK_ROTATE_RIGHT_5"
        echo -e "  ${YELLOW}[5]${NC} LOW_ENTROPY_MASK_ROTATE_LEFT_7"
        echo -e "  ${YELLOW}[6]${NC} LOW_ENTROPY_MASK_NO_ROTATION (Без вращения)"
        echo -e "  ${YELLOW}[7]${NC} Ввести своё значение вручную"
        echo ""
        read -p "Выберите вращение [1-7, по умолчанию 1]: " m_rot_choice
        case "$m_rot_choice" in
            1|"") sel_rot="LOW_ENTROPY_MASK_ROTATE_RIGHT_7" ;;
            2) sel_rot="LOW_ENTROPY_MASK_ROTATE_RIGHT_3" ;;
            3) sel_rot="LOW_ENTROPY_MASK_ROTATE_RIGHT_1" ;;
            4) sel_rot="LOW_ENTROPY_MASK_ROTATE_RIGHT_5" ;;
            5) sel_rot="LOW_ENTROPY_MASK_ROTATE_LEFT_7" ;;
            6) sel_rot="LOW_ENTROPY_MASK_NO_ROTATION" ;;
            7)
                read -p "Введите вращение (например, ROTATE_RIGHT_2): " custom_rot
                if [[ "$custom_rot" =~ ^LOW_ENTROPY_MASK_ ]]; then
                    sel_rot="$custom_rot"
                elif [ -n "$custom_rot" ]; then
                    sel_rot="LOW_ENTROPY_MASK_${custom_rot}"
                fi
                ;;
            *) sel_rot="LOW_ENTROPY_MASK_ROTATE_RIGHT_7" ;;
        esac
    fi

    local tmp_cfg="/tmp/mita_custom_entropy.json"
    jq --arg mode "$sel_mode" --arg rot "$sel_rot" \
       '.trafficPattern.lowEntropy = {"mode": $mode, "maskRotation": $rot} |
        .trafficPattern.unlockAll = true |
        .trafficPattern.tcpFragment = {"enable": true, "maxSleepMs": 15} |
        .trafficPattern.nonce = {"type": "NONCE_TYPE_PRINTABLE", "applyToAllUDPPacket": true, "minLen": 6, "maxLen": 8} |
        .trafficPattern.padding = {"maxMiddlePaddingLen": 64, "maxEndPaddingLen": 128}' \
       "$MIERU_CONFIG_FILE" > "$tmp_cfg" && mv "$tmp_cfg" "$MIERU_CONFIG_FILE"

    restart_mieru_and_verify
    echo -e "${GREEN}✓ Применена конфигурация: ${sel_mode} + ${sel_rot}${NC}"
    sleep 2
}

mieru_manage_presets() {
    while true; do
        show_mieru_header
        echo -e "${BOLD}--- Настройка обфускации трафика Mieru ---${NC}"
        echo -e "Текущий профиль: $(get_mieru_preset)"
        echo ""
        echo -e "${BOLD}Оптимальные готовые профили (Пресеты):${NC}"
        echo -e "  ${YELLOW}[1]${NC} 🚀 Anti-TSPU Max (Low-Entropy 32-bit + Rotate Right 7) ${GREEN}[Макс. скрытность для РФ]${NC}"
        echo "      • 32 бита данных + 32 бита паддинга (оверхед 2.0x), TCP-фрагментация 20ms, нонсы"
        echo ""
        echo -e "  ${YELLOW}[2]${NC} 🛡️ Anti-TSPU Balanced (Low-Entropy 48-bit + Rotate Right 7) ${CYAN}[Сбалансированный]${NC}"
        echo "      • 48 бит данных + 16 бит паддинга (оверхед 1.34x), TCP-фрагментация 15ms, нонсы"
        echo ""
        echo -e "  ${YELLOW}[3]${NC} ⚡ Anti-TSPU Light (Low-Entropy 56-bit + Rotate Right 3) ${YELLOW}[Экономия трафика]${NC}"
        echo "      • 56 бит данных + 8 бит паддинга (оверхед 1.15x), TCP-фрагментация 10ms, нонсы"
        echo ""
        echo -e "  ${YELLOW}[4]${NC} 🔒 Basic / Medium (Фрагментация + ASCII нонсы, без низкой энтропии)"
        echo ""
        echo -e "  ${YELLOW}[5]${NC} 🔓 Отключить обфускацию (Чистый Mieru, максимальная скорость)"
        echo ""
        echo -e "${BOLD}Ручной конструктор (Своя комбинация режима и маски):${NC}"
        echo -e "  ${YELLOW}[6]${NC} 🛠️ Настроить вручную (Выбор любого режима энтропии и маски)"
        echo ""
        echo -e "  ${YELLOW}[0]${NC} ⬅️ Назад в меню Mieru"
        echo ""
        read -p "Выберите вариант [0-6]: " p_choice

        local tmp_cfg="/tmp/mita_preset_cfg.json"
        case "$p_choice" in
            1)
                jq '.trafficPattern = {
                    "unlockAll": true,
                    "tcpFragment": {"enable": true, "maxSleepMs": 20},
                    "nonce": {"type": "NONCE_TYPE_PRINTABLE", "applyToAllUDPPacket": true, "minLen": 6, "maxLen": 8},
                    "padding": {"maxMiddlePaddingLen": 128, "maxEndPaddingLen": 255},
                    "lowEntropy": {"mode": "LOW_ENTROPY_MODE_32", "maskRotation": "LOW_ENTROPY_MASK_ROTATE_RIGHT_7"}
                }' "$MIERU_CONFIG_FILE" > "$tmp_cfg" && mv "$tmp_cfg" "$MIERU_CONFIG_FILE"
                restart_mieru_and_verify
                echo -e "${GREEN}✓ Установлен профиль Anti-TSPU Max (32-bit + Rotate Right 7)${NC}"
                sleep 2
                ;;
            2)
                jq '.trafficPattern = {
                    "unlockAll": true,
                    "tcpFragment": {"enable": true, "maxSleepMs": 15},
                    "nonce": {"type": "NONCE_TYPE_PRINTABLE", "applyToAllUDPPacket": true, "minLen": 6, "maxLen": 8},
                    "padding": {"maxMiddlePaddingLen": 64, "maxEndPaddingLen": 128},
                    "lowEntropy": {"mode": "LOW_ENTROPY_MODE_48", "maskRotation": "LOW_ENTROPY_MASK_ROTATE_RIGHT_7"}
                }' "$MIERU_CONFIG_FILE" > "$tmp_cfg" && mv "$tmp_cfg" "$MIERU_CONFIG_FILE"
                restart_mieru_and_verify
                echo -e "${GREEN}✓ Установлен профиль Anti-TSPU Balanced (48-bit + Rotate Right 7)${NC}"
                sleep 2
                ;;
            3)
                jq '.trafficPattern = {
                    "unlockAll": true,
                    "tcpFragment": {"enable": true, "maxSleepMs": 10},
                    "nonce": {"type": "NONCE_TYPE_PRINTABLE", "applyToAllUDPPacket": true, "minLen": 6, "maxLen": 8},
                    "padding": {"maxMiddlePaddingLen": 32, "maxEndPaddingLen": 64},
                    "lowEntropy": {"mode": "LOW_ENTROPY_MODE_56", "maskRotation": "LOW_ENTROPY_MASK_ROTATE_RIGHT_3"}
                }' "$MIERU_CONFIG_FILE" > "$tmp_cfg" && mv "$tmp_cfg" "$MIERU_CONFIG_FILE"
                restart_mieru_and_verify
                echo -e "${GREEN}✓ Установлен профиль Anti-TSPU Light (56-bit + Rotate Right 3)${NC}"
                sleep 2
                ;;
            4)
                jq '.trafficPattern = {
                    "unlockAll": false,
                    "tcpFragment": {"enable": true, "maxSleepMs": 10},
                    "nonce": {"type": "NONCE_TYPE_PRINTABLE", "applyToAllUDPPacket": true, "minLen": 6, "maxLen": 8},
                    "padding": {"maxMiddlePaddingLen": 64, "maxEndPaddingLen": 128},
                    "lowEntropy": {"mode": "LOW_ENTROPY_MODE_OFF", "maskRotation": "LOW_ENTROPY_MASK_NO_ROTATION"}
                }' "$MIERU_CONFIG_FILE" > "$tmp_cfg" && mv "$tmp_cfg" "$MIERU_CONFIG_FILE"
                restart_mieru_and_verify
                echo -e "${GREEN}✓ Установлен профиль Basic/Medium (без низкой энтропии)${NC}"
                sleep 2
                ;;
            5)
                jq '.trafficPattern = {
                    "unlockAll": false,
                    "tcpFragment": {"enable": false, "maxSleepMs": 0},
                    "padding": {"maxMiddlePaddingLen": 0, "maxEndPaddingLen": 0},
                    "lowEntropy": {"mode": "LOW_ENTROPY_MODE_OFF", "maskRotation": "LOW_ENTROPY_MASK_NO_ROTATION"}
                }' "$MIERU_CONFIG_FILE" > "$tmp_cfg" && mv "$tmp_cfg" "$MIERU_CONFIG_FILE"
                restart_mieru_and_verify
                echo -e "${GREEN}✓ Обфускация Mieru отключена${NC}"
                sleep 2
                ;;
            6)
                mieru_custom_entropy_builder
                ;;
            0) return ;;
            *) echo "Неверный выбор"; sleep 1 ;;
        esac
    done
}

mieru_manage_routing() {
    show_mieru_header
    echo -e "${BOLD}--- Настройка маршрутизации Mieru ---${NC}"
    echo -e "Текущий режим: $(get_mieru_routing)"
    echo ""
    echo -e "  ${YELLOW}[1]${NC} 🌐 Маршрутизация Xray"
    echo -e "  ${YELLOW}[2]${NC} ⚡ Прямой выход"
    echo ""
    echo -e "  ${YELLOW}[0]${NC} Назад"
    echo ""
    read -p "Выберите режим [0-2]: " r_choice
    case "$r_choice" in
        1)
            local tmp_cfg="/tmp/mita_egress_cfg.json"
            jq '.egress = {"proxies": [{"name": "xray_socks", "protocol": "SOCKS5_PROXY_PROTOCOL", "host": "127.0.0.1", "port": 10808}], "rules": [{"ipRanges": ["*"], "domainNames": ["*"], "action": "PROXY", "proxyNames": ["xray_socks"]}]}' \
               "$MIERU_CONFIG_FILE" > "$tmp_cfg" && mv "$tmp_cfg" "$MIERU_CONFIG_FILE"
            restart_mieru_and_verify
            echo -e "${GREEN}✓ Маршрутизация Mieru: Xray${NC}"
            sleep 2
            ;;
        2)
            local tmp_cfg="/tmp/mita_no_egress.json"
            jq 'del(.egress)' "$MIERU_CONFIG_FILE" > "$tmp_cfg" && mv "$tmp_cfg" "$MIERU_CONFIG_FILE"
            restart_mieru_and_verify
            echo -e "${GREEN}✓ Маршрутизация Mieru: Прямой выход${NC}"
            sleep 2
            ;;
        0) return ;;
    esac
}

mieru_export_links() {
    show_mieru_header
    echo -e "${BOLD}--- Выберите пользователя Mieru для экспорта конфига ---${NC}"
    local users=($(cat "$MIERU_USER_STORE" | jq -r 'keys[]'))
    if [ ${#users[@]} -eq 0 ]; then
        echo -e "${RED}Нет пользователей!${NC}"
        read -p "Нажмите Enter..."
        return
    fi

    for i in "${!users[@]}"; do
        echo -e "${YELLOW}[$((i+1))]${NC} ${users[$i]}"
    done
    echo ""
    read -p "Выберите номер пользователя [1-${#users[@]}]: " u_idx
    [ -z "$u_idx" ] && return
    local selected_user="${users[$((u_idx-1))]}"
    local selected_pass=$(cat "$MIERU_USER_STORE" | jq -r --arg u "$selected_user" '.[$u]')
    local ports_str=$(get_mieru_ports)
    local p_range=$(echo "$ports_str" | cut -d'/' -f1)
    local proto=$(echo "$ports_str" | cut -d'/' -f2)
    local pattern=$(mita export traffic-pattern 2>/dev/null)
    local low_mode=$(jq -r '.trafficPattern.lowEntropy.mode // "LOW_ENTROPY_MODE_OFF"' "$MIERU_CONFIG_FILE" 2>/dev/null)
    local mask_rot=$(jq -r '.trafficPattern.lowEntropy.maskRotation // "LOW_ENTROPY_MASK_NO_ROTATION"' "$MIERU_CONFIG_FILE" 2>/dev/null)
    local m_tag=$(get_mieru_tag)

    local mierus_url="mierus://${selected_user}:${selected_pass}@${SERVER_IP}/?profile=${m_tag}&port=${p_range}&protocol=${proto}&multiplexing=MULTIPLEXING_HIGH&traffic-pattern=${pattern}"
    if [ "$low_mode" != "LOW_ENTROPY_MODE_OFF" ] && [ -n "$low_mode" ]; then
        mierus_url="${mierus_url}&low-entropy-mode=${low_mode}&low-entropy-mask-rotation=${mask_rot}"
    fi

    show_mieru_header
    echo -e "${GREEN}${BOLD}=== ДАННЫЕ ПОДКЛЮЧЕНИЯ MIERU (NekoBox+ / Karing) ===${NC}"
    echo ""
    echo -e "  ${BOLD}Имя профиля (Tag):${NC}             ${CYAN}${m_tag}${NC}"
    echo -e "  ${BOLD}Сервер (IP):${NC}                   ${SERVER_IP}"
    echo -e "  ${BOLD}Порты:${NC}                         ${p_range}"
    echo -e "  ${BOLD}Протокол:${NC}                      ${proto}"
    echo -e "  ${BOLD}Имя пользователя:${NC}              ${selected_user}"
    echo -e "  ${BOLD}Пароль:${NC}                        ${selected_pass}"
    echo -e "  ${BOLD}Мультиплексирование:${NC}          HIGH"
    echo -e "  ${BOLD}Паттерн трафика:${NC}               ${pattern}"
    echo -e "  ${BOLD}Режим низкой энтропии:${NC}         ${PURPLE}${low_mode}${NC}"
    echo -e "  ${BOLD}Вращение маски низкой энтропии:${NC} ${PURPLE}${mask_rot}${NC}"
    echo -e "  ${BOLD}Маршрутизация:${NC}                 $(get_mieru_routing)"
    echo ""
    echo -e "${YELLOW}Настройка параметров низкой энтропии в NekoBox+:${NC}"
    echo -e "  1. При импорте ссылки или QR-кода поля 'Имя профиля' и 'Паттерн' заполняются автоматически."
    echo -e "  2. Для защиты ИСХОДЯЩЕГО трафика смартфона от ТСПУ выберите в профиле:"
    echo -e "     • Режим низкой энтропии:          ${CYAN}${low_mode}${NC}"
    echo -e "     • Вращение маски низкой энтропии: ${CYAN}${mask_rot}${NC}"
    echo ""
    echo -e "${BOLD}Ссылка mierus://${NC}"
    echo -e "${CYAN}${mierus_url}${NC}"
    echo ""
    echo -e "${BOLD}QR-код для сканирования камерой в NekoBox+:${NC}"
    qrencode -t ANSI256 "$mierus_url" 2>/dev/null || qrencode -t UTF8 "$mierus_url" 2>/dev/null || echo "qrencode не смог отрендерить"
    echo ""
    read -p "Нажмите Enter для возврата..."
}

menu_mieru() {
    if ! is_mieru_installed; then
        clear
        echo -e "${YELLOW}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${YELLOW}║${BOLD}                     MIERU НЕ ОБНАРУЖЕН                               ${YELLOW}║${NC}"
        echo -e "${YELLOW}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "${RED}Служба mita или исполняемый файл mita не найдены на данном сервере.${NC}"
        echo ""
        read -p "Нажмите Enter для возврата..."
        return
    fi
    while true; do
        show_mieru_header
        echo -e "  ${YELLOW}[1]${NC} 📊 Статус службы Mita (Mieru) и сокеты"
        echo -e "  ${YELLOW}[2]${NC} 🌐 Маршрутизация трафика (Xray / Прямой выход)"
        echo -e "  ${YELLOW}[3]${NC} 🛡️  Настройка обфускации (Low-Entropy, Маска, Паттерн)"
        echo -e "  ${YELLOW}[4]${NC} 👥 Управление пользователями и паролями"
        echo -e "  ${YELLOW}[5]${NC} 🏷️  Сменить имя подключения (${CYAN}$(get_mieru_tag)${NC})"
        echo -e "  ${YELLOW}[6]${NC} ⚙️  Сменить порты подключения"
        echo -e "  ${YELLOW}[7]${NC} 📱 Экспорт конфигурации (Данные, Ссылка, QR-код)"
        echo -e "  ${YELLOW}[8]${NC} 📜 Живые логи службы (journalctl)"
        echo -e "  ${YELLOW}[9]${NC} 🔄 Перезапустить службу mita"
        echo -e "  ${YELLOW}[0]${NC} ⬅️  Назад в Главное Меню"
        echo ""
        read -p "Выберите пункт [0-9]: " m_choice
        case "$m_choice" in
            1)
                show_mieru_header
                systemctl status mita --no-pager
                echo ""
                ss -tulpn | grep mita || echo "Сокеты не найдены"
                echo ""
                read -p "Нажмите Enter..."
                ;;
            2) mieru_manage_routing ;;
            3) mieru_manage_presets ;;
            4) mieru_manage_users ;;
            5) mieru_change_tag ;;
            6) mieru_manage_ports ;;
            7) mieru_export_links ;;
            8) journalctl -u mita -f -n 50 ;;
            9) restart_mieru_and_verify; sleep 2 ;;
            0) return ;;
            *) echo "Неверный выбор"; sleep 1 ;;
        esac
    done
}

# ==============================================================================
# РАЗДЕЛ 2: УПРАВЛЕНИЕ SNELL (v5.0.1)
# ==============================================================================
show_snell_header() {
    clear
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}            РАЗДЕЛ: УПРАВЛЕНИЕ SNELL v5                  ${CYAN}║${NC}"
    echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
    echo -e "${CYAN}║${NC}  Сервер:  ${BOLD}${SERVER_IP}${NC}  |  Служба: $(get_snell_status)"
    echo -e "${CYAN}║${NC}  Имя:     ${BOLD}$(get_snell_tag)${NC}  |  Протокол: ${BOLD}Snell v5.0.1${NC}"
    echo -e "${CYAN}║${NC}  Порт:    ${BOLD}$(get_snell_port)${NC} (TCP+UDP QUIC)  |  Обфускация: $(get_snell_obfs)"
    echo -e "${CYAN}║${NC}  Маршрут: $(get_snell_routing)"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
}

snell_manage_routing() {
    show_snell_header
    echo -e "${BOLD}--- Настройка маршрутизации Snell v5 ---${NC}"
    echo -e "Текущий режим: $(get_snell_routing)"
    echo ""
    echo -e "  ${YELLOW}[1]${NC} 🌐 Маршрутизация Xray"
    echo -e "  ${YELLOW}[2]${NC} ⚡ Прямой выход"
    echo ""
    echo -e "  ${YELLOW}[0]${NC} Назад"
    echo ""
    read -p "Выберите режим [0-2]: " s_rt_choice
    case "$s_rt_choice" in
        1)
            mkdir -p /etc/snell
            echo "xray" > /etc/snell/routing.mode
            /usr/local/bin/snell-routing.sh
            echo -e "${GREEN}✓ Маршрутизация Snell: Xray${NC}"
            sleep 2
            ;;
        2)
            mkdir -p /etc/snell
            echo "direct" > /etc/snell/routing.mode
            /usr/local/bin/snell-routing.sh
            echo -e "${GREEN}✓ Маршрутизация Snell: Прямой выход${NC}"
            sleep 2
            ;;
        0) return ;;
        *) echo "Неверный выбор"; sleep 1 ;;
    esac
}

snell_manage_obfs() {
    show_snell_header
    echo -e "${BOLD}--- Настройка обфускации Snell v5 ---${NC}"
    echo "Текущий режим: $(get_snell_obfs)"
    echo ""
    echo -e "  ${YELLOW}[1]${NC} 🌐 HTTP-обфускация с доменом-приманкой"
    echo "      (Введите любой домен для маскировки, например: ya.ru, vk.com, dzen.ru)"
    echo ""
    echo -e "  ${YELLOW}[2]${NC} ⚡ Отключить обфускацию (Чистый Snell v5, 0-RTT, минимум задержек)"
    echo "      (В NekoBox+ режим обфускации: none)"
    echo ""
    echo -e "  ${YELLOW}[0]${NC} Отмена"
    echo ""
    read -p "Выберите режим [0-2]: " ob_choice
    case "$ob_choice" in
        1)
            read -p "Введите домен для HTTP маскировки (например, ya.ru или vk.com): " custom_host
            [ -z "$custom_host" ] && return
            sed -i '/^obfs/d' "$SNELL_CONFIG_FILE"
            echo "obfs = http" >> "$SNELL_CONFIG_FILE"
            echo "obfs-host = ${custom_host}" >> "$SNELL_CONFIG_FILE"
            restart_snell_and_verify
            echo -e "${GREEN}✓ Установлена HTTP-обфускация: ${custom_host}${NC}"
            sleep 2
            ;;
        2)
            sed -i '/^obfs/d' "$SNELL_CONFIG_FILE"
            echo "obfs = off" >> "$SNELL_CONFIG_FILE"
            restart_snell_and_verify
            echo -e "${GREEN}✓ Обфускация отключена (Чистый Snell v5)${NC}"
            sleep 2
            ;;
        0) return ;;
        *) echo "Неверный выбор"; sleep 1 ;;
    esac
}


snell_change_psk() {
    show_snell_header
    local cur_psk=$(get_snell_psk)
    echo -e "${BOLD}--- Управление PSK ключом Snell v5 ---${NC}"
    echo -e "Текущий PSK: ${GREEN}${BOLD}${cur_psk}${NC}"
    echo ""
    echo -e "  ${YELLOW}[1]${NC} Ввести свой ключ вручную"
    echo -e "  ${YELLOW}[2]${NC} 🎲 Сгенерировать новый случайный ключ"
    echo -e "  ${YELLOW}[0]${NC} Назад"
    echo ""
    read -p "Выберите действие [0-2]: " psk_act
    local new_psk=""
    case "$psk_act" in
        1)
            read -p "Введите новый PSK ключ: " new_psk
            new_psk=$(echo "$new_psk" | tr -d '[:space:]')
            [ -z "$new_psk" ] && return
            ;;
        2)
            new_psk=$(openssl rand -base64 24 | tr -dc 'a-zA-Z0-9' | head -c 30)
            echo -e "Сгенерирован ключ: ${GREEN}${BOLD}${new_psk}${NC}"
            ;;
        0) return ;;
        *) echo "Неверный выбор"; sleep 1; return ;;
    esac

    sed -i '/^psk/d' "$SNELL_CONFIG_FILE"
    echo "psk = ${new_psk}" >> "$SNELL_CONFIG_FILE"
    restart_snell_and_verify
    echo -e "${GREEN}✓ PSK ключ Snell успешно обновлён!${NC}"
    sleep 2
}

snell_change_port() {
    show_snell_header
    local cur_port=$(get_snell_port)
    echo -e "${BOLD}--- Смена порта подключения Snell v5 (Гибридный TCP + UDP/QUIC) ---${NC}"
    echo -e "Текущий порт: ${CYAN}${BOLD}${cur_port}${NC} (TCP + UDP / QUIC)"
    echo ""
    read -p "Введите новый порт (1-65535): " new_port
    new_port=$(echo "$new_port" | tr -d '[:space:]')
    [ -z "$new_port" ] && return

    if ! [[ "$new_port" =~ ^[0-9]+$ ]] || [ "$new_port" -lt 1 ] || [ "$new_port" -gt 65535 ]; then
        echo -e "${RED}Ошибка: порт должен быть числом от 1 до 65535!${NC}"
        sleep 2
        return
    fi

    sed -i '/^listen/d' "$SNELL_CONFIG_FILE"
    sed -i "/^\[snell-server\]/a listen = 0.0.0.0:${new_port}" "$SNELL_CONFIG_FILE"

    iptables -I INPUT 1 -p tcp --dport "$new_port" -j ACCEPT 2>/dev/null || true
    iptables -I INPUT 1 -p udp --dport "$new_port" -j ACCEPT 2>/dev/null || true
    if [ "$cur_port" != "$new_port" ]; then
        iptables -D INPUT -p tcp --dport "$cur_port" -j ACCEPT 2>/dev/null || true
        iptables -D INPUT -p udp --dport "$cur_port" -j ACCEPT 2>/dev/null || true
    fi

    restart_snell_and_verify
    echo -e "${GREEN}✓ Порт Snell успешно изменён на: ${new_port} (TCP + UDP открыты)!${NC}"
    sleep 2
}

snell_export_links() {
    show_snell_header
    local s_port=$(get_snell_port)
    local s_psk=$(get_snell_psk)
    local obfs_mode=$(grep -a -E "^obfs[[:space:]]*=" "$SNELL_CONFIG_FILE" | awk -F'=' '{print $2}' | tr -d ' ')
    local obfs_host=$(grep -a -E "^obfs-host[[:space:]]*=" "$SNELL_CONFIG_FILE" | awk -F'=' '{print $2}' | tr -d ' ')

    [ -z "$obfs_mode" ] && obfs_mode="off"
    [ -z "$obfs_host" ] && obfs_host=""

    local client_obfs="none"
    [ "$obfs_mode" = "http" ] && client_obfs="http"
    [ "$obfs_mode" = "tls" ] && client_obfs="tls"

    local tag=$(get_snell_tag)
    local snell_url="snell://${s_psk}@${SERVER_IP}:${s_port}/?version=5"
    if [ "$obfs_mode" != "off" ] && [ -n "$obfs_mode" ]; then
        snell_url="${snell_url}&obfs-mode=${client_obfs}&obfs-host=${obfs_host}"
    fi
    snell_url="${snell_url}#${tag}"

    local surge_line="${tag} = snell, ${SERVER_IP}, ${s_port}, psk=${s_psk}, version=5"
    if [ "$obfs_mode" != "off" ] && [ -n "$obfs_mode" ]; then
        surge_line="${surge_line}, obfs=${obfs_mode}, obfs-host=${obfs_host}"
    fi
    surge_line="${surge_line}, reuse=true, tfo=true, udp-relay=true"

    echo -e "${GREEN}${BOLD}=== ДАННЫЕ ПОДКЛЮЧЕНИЯ SNELL v5 (NekoBox+ / Surge) ===${NC}"
    echo ""
    echo -e "${CYAN}${BOLD}--- ПАРАМЕТРЫ ПОДКЛЮЧЕНИЯ ---${NC}"
    echo -e "  • Протокол:              ${BOLD}Snell v5 (Гибридный: TCP + UDP / QUIC 0-RTT)${NC}"
    echo -e "  • Сервер (Адрес):        ${BOLD}${SERVER_IP}${NC}"
    echo -e "  • Порт:                  ${BOLD}${s_port}${NC}"
    echo -e "  • Пароль (PSK):          ${GREEN}${BOLD}${s_psk}${NC}"
    echo -e "  • Версия:                ${BOLD}5${NC}"
    echo -e "  • Ключ пользователя:     ${BOLD}(Оставить пустым)${NC}"
    echo -e "  • Режим обфускации:      ${BOLD}${client_obfs}${NC}"
    if [ "$client_obfs" != "none" ]; then
        echo -e "  • Хост обфускации:       ${BOLD}${obfs_host}${NC}"
    fi
    echo -e "  • Маршрутизация выхода:  $(get_snell_routing)"
    echo ""
    echo -e "${BOLD}--- Ссылка snell:// v5 для NekoBox+ / Surge ---${NC}"
    echo -e "${CYAN}${snell_url}${NC}"
    echo ""
    echo -e "${BOLD}--- Строка для Surge / Shadowrocket ---${NC}"
    echo -e "${YELLOW}${surge_line}${NC}"
    echo ""
    echo -e "${BOLD}--- QR-код для сканирования камерой в NekoBox+ ---${NC}"
    qrencode -t ANSI256 "$snell_url" 2>/dev/null || qrencode -t UTF8 "$snell_url" 2>/dev/null || echo "qrencode не смог отрендерить"
    echo ""
    read -p "Нажмите Enter для возврата..."
}

menu_snell() {
    if ! is_snell_installed; then
        clear
        echo -e "${YELLOW}╔══════════════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${YELLOW}║${BOLD}                    SNELL v5 НЕ ОБНАРУЖЕН                             ${YELLOW}║${NC}"
        echo -e "${YELLOW}╚══════════════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "${RED}Служба snell или бинарник snell-server не найдены на данном сервере.${NC}"
        echo ""
        read -p "Нажмите Enter для возврата..."
        return
    fi
    while true; do
        show_snell_header
        echo -e "  ${YELLOW}[1]${NC} 📊 Статус службы Snell и сокеты"
        echo -e "  ${YELLOW}[2]${NC} 🌐 Маршрутизация трафика (Xray / Прямой выход)"
        echo -e "  ${YELLOW}[3]${NC} 🛡️  Настройка обфускации (HTTP / Отключена)"
        echo -e "  ${YELLOW}[4]${NC} 🏷️  Сменить имя подключения (${CYAN}$(get_snell_tag)${NC})"
        echo -e "  ${YELLOW}[5]${NC} 🔑 Управление PSK ключом (Показать / Сгенерировать новый)"
        echo -e "  ${YELLOW}[6]${NC} ⚙️  Сменить порт подключения"
        echo -e "  ${YELLOW}[7]${NC} 📱 Конфигурация для NekoBox+ / Surge (Параметры, Ссылка, QR)"
        echo -e "  ${YELLOW}[8]${NC} 📜 Живые логи службы (journalctl)"
        echo -e "  ${YELLOW}[9]${NC} 🔄 Перезапустить службу snell"
        echo -e "  ${YELLOW}[0]${NC} ⬅️  Назад в Главное Меню"
        echo ""
        read -p "Выберите пункт [0-9]: " s_choice
        case "$s_choice" in
            1)
                show_snell_header
                systemctl status snell --no-pager
                echo ""
                ss -tulpn | grep snell || echo "Сокеты не найдены"
                echo ""
                read -p "Нажмите Enter..."
                ;;
            2) snell_manage_routing ;;
            3) snell_manage_obfs ;;
            4) snell_change_tag ;;
            5) snell_change_psk ;;
            6) snell_change_port ;;
            7) snell_export_links ;;
            8) journalctl -u snell -f -n 50 ;;
            9) restart_snell_and_verify; sleep 2 ;;
            0) return ;;
            *) echo "Неверный выбор"; sleep 1 ;;
        esac
    done
}

# ==============================================================================
# РАЗДЕЛ 3: УПРАВЛЕНИЕ WDTT / QWDTT (VPN-СЕРВЕР)
# ==============================================================================
show_wdtt_header() {
    clear
    local peer_p=$(get_wdtt_peer_port)
    local prof_name=$(get_wdtt_profile_name)
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}             РАЗДЕЛ: УПРАВЛЕНИЕ WDTT / QWDTT (VPN-СЕРВЕР)             ${CYAN}║${NC}"
    echo -e "${CYAN}╠══════════════════════════════════════════════════════════════════════╣${NC}"
    echo -e "${CYAN}║${NC}  Сервер:   ${BOLD}${SERVER_IP}${NC}  |  Служба: $(get_wdtt_status)"
    echo -e "${CYAN}║${NC}  Порты:    ${BOLD}:${peer_p}/UDP (VPN) | 56002 (Direct) | 56003 (Raw) | 56001 (WG)${NC}"
    echo -e "${CYAN}║${NC}  Профиль:  ${BOLD}${prof_name}${NC}"
    echo -e "${CYAN}║${NC}  Маршрут:  $(get_wdtt_routing)  |  Пароль: ${GREEN}$(get_wdtt_password)${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
}

wdtt_manage_routing() {
    show_wdtt_header
    echo -e "${BOLD}--- Настройка маршрутизации WDTT (qwdtt) ---${NC}"
    echo -e "Текущий режим: $(get_wdtt_routing)"
    echo ""
    echo -e "  ${YELLOW}[1]${NC} 🌐 Маршрутизация Xray"
    echo -e "  ${YELLOW}[2]${NC} ⚡ Прямой выход"
    echo ""
    echo -e "  ${YELLOW}[0]${NC} Назад"
    echo ""
    read -p "Выберите режим [0-2]: " w_rt_choice
    case "$w_rt_choice" in
        1)
            /usr/local/bin/wdtt-tproxy.sh
            systemctl enable wdtt-tproxy 2>/dev/null || true
            systemctl restart wdtt-tproxy 2>/dev/null || true
            while iptables -t nat -D POSTROUTING -s 10.66.0.0/16 -j MASQUERADE 2>/dev/null; do :; done
            while iptables -t nat -D POSTROUTING -s 10.66.0.0/16 -o "$WAN_IF" -j MASQUERADE 2>/dev/null; do :; done
            while iptables -t nat -D POSTROUTING -s 10.66.0.0/16 -o "$WAN_IF" -m comment --comment WDTT_MANAGED -j MASQUERADE 2>/dev/null; do :; done
            while iptables -t nat -D POSTROUTING -s 10.70.0.0/16 -j MASQUERADE 2>/dev/null; do :; done
            while iptables -t nat -D POSTROUTING -s 10.70.0.0/16 -o "$WAN_IF" -j MASQUERADE 2>/dev/null; do :; done
            while iptables -t nat -D POSTROUTING -s 10.70.0.0/16 -o "$WAN_IF" -m comment --comment WDTT_RAW_MANAGED -j MASQUERADE 2>/dev/null; do :; done
            echo -e "${GREEN}✓ Маршрутизация WDTT: Xray (TPROXY)${NC}"
            sleep 2
            ;;
        2)
            iptables -t mangle -D PREROUTING -i wdtt0 -j WDTT_TPROXY 2>/dev/null || true
            iptables -t mangle -D PREROUTING -i wdttraw0 -j WDTT_TPROXY 2>/dev/null || true
            systemctl stop wdtt-tproxy 2>/dev/null || true
            systemctl disable wdtt-tproxy 2>/dev/null || true
            iptables -t nat -C POSTROUTING -s 10.66.0.0/16 -o "$WAN_IF" -m comment --comment WDTT_MANAGED -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -s 10.66.0.0/16 -o "$WAN_IF" -m comment --comment WDTT_MANAGED -j MASQUERADE
            iptables -t nat -C POSTROUTING -s 10.70.0.0/16 -o "$WAN_IF" -m comment --comment WDTT_RAW_MANAGED -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -s 10.70.0.0/16 -o "$WAN_IF" -m comment --comment WDTT_RAW_MANAGED -j MASQUERADE
            echo -e "${GREEN}✓ Маршрутизация WDTT: Прямой выход (NAT MASQUERADE)${NC}"
            sleep 2
            ;;
        0) return ;;
    esac
}

wdtt_view_devices() {
    show_wdtt_header
    echo -e "${BOLD}--- Активные устройства и клиенты WDTT ---${NC}"
    if [ -f "$WDTT_DB_FILE" ]; then
        jq -r '.devices // empty | to_entries[] | "  Устройство ID: \(.value.device_id) | IP: \(.value.ip // "N/A") | Вх: \((.value.down_bytes // 0) / 1048576 | floor) МБ | Исх: \((.value.up_bytes // 0) / 1048576 | floor) МБ"' "$WDTT_DB_FILE" 2>/dev/null || echo "  Нет подключенных устройств"
    else
        echo "  Файл базы устройств не найден"
    fi
    echo ""
    read -p "Нажмите Enter для возврата..."
}

show_qwdtt_link() {
    clear
    local peer_p=$(get_wdtt_peer_port)
    local pass=$(get_wdtt_password)
    local name=$(get_wdtt_profile_name)

    local qwdtt_url=$(python3 -c "
import urllib.parse, sys
name, ip, port, password = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
name_enc = urllib.parse.quote_plus(name)
peer_enc = f'{ip}%3A{port}'
pass_enc = urllib.parse.quote_plus(password)
print(f'qwdtt://config?name={name_enc}&peer={peer_enc}&hashes=&workers=18&port=9000&pass={pass_enc}')
" "$name" "$SERVER_IP" "$peer_p" "$pass" 2>/dev/null || echo "")

    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${BOLD}          ССЫЛКА ПОДКЛЮЧЕНИЯ И QR-КОД QWDTT (WDTT VPN)                ${CYAN}║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${BOLD}Параметры подключения:${NC}"
    echo -e "  • Название профиля:    ${GREEN}${name}${NC}"
    echo -e "  • Сервер (IP:Порт):    ${CYAN}${SERVER_IP}:${peer_p}${NC}"
    echo -e "  • Внутренний порт:     ${CYAN}9000${NC}"
    echo -e "  • Количество воркеров: ${CYAN}18${NC}"
    echo -e "  • Пароль подключения:  ${GREEN}${pass}${NC}"
    echo -e "  • Режим маршрута:      $(get_wdtt_routing)"
    echo ""
    echo -e "${BOLD}Ссылка конфигурации (qwdtt://):${NC}"
    echo -e "${YELLOW}${qwdtt_url}${NC}"
    echo ""
    echo -e "${BOLD}QR-код для импорта в клиент QWDTT:${NC}"
    echo ""
    qrencode -t ANSI256 "$qwdtt_url" 2>/dev/null || qrencode -t UTF8 "$qwdtt_url" 2>/dev/null || echo "qrencode не установлен или не смог отрендерить QR"
    echo ""
    echo -e "${CYAN}────────────────────────────────────────────────────────────────────────${NC}"
    echo -e "Скопируйте ссылку выше или отсканируйте QR-код в мобильном клиенте ${BOLD}qwdtt${NC}."
    echo -e "${CYAN}────────────────────────────────────────────────────────────────────────${NC}"
    echo ""
    read -p "Нажмите Enter для возврата в меню..."
}

